{
    // This is the Worker project name (shows up in dashboard)
    "name": "${EXTRACTS_BUCKET}-queue",
    "main": "queue-worker.js",

    "compatibility_date": "2025-11-13",

    "observability": {
        "enabled": true,
        "logs": {
        "head_sampling_rate": 1.0
        }
    },

    "env": {
        // Parameters for live code
        "live": {
            "name": "${EXTRACTS_BUCKET}-queue",
            "r2_buckets": [
                {
                    "binding": "BUCKET",
                    "bucket_name": "${EXTRACTS_BUCKET}"
                }
            ],
            "queues": {
                "consumers": [
                    {
                        "queue": "${EXTRACTS_BUCKET}"
                    }
                ]
            }
        },
        // Parameters for test code
        "test": {
            "name": "${EXTRACTS_BUCKET}-queue-test",
            "r2_buckets": [
                {
                    "binding": "BUCKET",
                    "bucket_name": "${EXTRACTS_BUCKET}"
                }
            ],
            "queues": {
                "consumers": [
                    {
                        "queue": "${EXTRACTS_BUCKET}-test"
                    }
                ]
            }
        }
    }
}
