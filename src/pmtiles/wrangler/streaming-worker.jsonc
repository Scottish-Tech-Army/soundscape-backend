{
    // Note that bucket name and worker names match, for simplicity
    "name": "${PMTILES_BUCKET}-stream",
    "main": "streamer.js",
    "observability": {
        "enabled": true
    },
    "vars": {
        "ORIGIN_BASE_URL": "${TILES_URL}",
        "CURRENT_DATESTAMP": "${DATESTAMP}"
    },
    "r2_buckets": [
        {
            "binding": "BUCKET",
            "bucket_name": "${PMTILES_BUCKET}"
        }
    ],
    "compatibility_date": "2025-10-12"
}
