{
    // Parameters for both workers
    "name": "pmtiles",
    "main": "dist/index.js",
    "observability": {
        "enabled": true
    },

    "env": {
        // Parameters for live code
        "live": {
            "name": "pmtiles",
            "vars": {
                "PMTILES_PATH": "${PMTILES_PATH}"
            },
            "r2_buckets": [
                {
                    "binding": "BUCKET",
                    "bucket_name": "R2_BUCKET" // Interpolated with sed
                }
            ]
        },
        // Parameters for test code
        "test": {
            "name": "pmtiles-test",
            "vars": {
                "PMTILES_PATH": "${PMTILES_PATH}"
            },
            "r2_buckets": [
                {
                    "binding": "BUCKET",
                    "bucket_name": "R2_BUCKET" // Interpolated with sed
                }
            ]
        }
    },
    "compatibility_date": "2025-10-12"
}
