{
    // Parameters for both workers
    // Note that bucket name and worker names match, for simplicity
    "name": "${EXTRACTS_BUCKET}",
    "main": "extracts.js",

    "observability": {
        "enabled": true,
        "logs": {
        "head_sampling_rate": 1.0
        }
    },


    "env": {
        // Parameters for live code
        "live": {
            "name": "${EXTRACTS_BUCKET}",
            "vars": {
                "ORIGIN_BASE_URL": "${EXTRACTS_URL}",
                "CURRENT_DATESTAMP": "${DATESTAMP}"
            },
            "r2_buckets": [
                {
                    "binding": "BUCKET",
                    "bucket_name": "${EXTRACTS_BUCKET}"
                }
            ],
            "queues": {
                "producers": [
                    {
                        "binding": "QUEUE",
                        "queue": "${EXTRACTS_BUCKET}"
                    }
                ]
            }
        },
        // Parameters for test code
        "test": {
            "name": "${EXTRACTS_BUCKET}-test",
            "vars": {
                "ORIGIN_BASE_URL": "${EXTRACTS_URL}",
                "CURRENT_DATESTAMP": "${DATESTAMP}"
            },
            "r2_buckets": [
                {
                    "binding": "BUCKET",
                    "bucket_name": "${EXTRACTS_BUCKET}"
                }
            ],
            "queues": {
                "producers": [
                    {
                        "binding": "QUEUE",
                        "queue": "${EXTRACTS_BUCKET}-test"
                    }
                ]
            }
        }
    },
    "compatibility_date": "2025-10-12"
}
