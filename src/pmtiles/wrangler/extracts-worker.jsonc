{
    // Parameters for both workers
    // FIXME: make parametrisable
    "name": "extracts",
    "main": "streamer.js",
    "observability": {
        "enabled": true
    },

    "env": {
        // Parameters for live code
        "live": {
            "name": "extracts",
            "vars": {
                "ORIGIN_BASE_URL": "${EXTRACTS_URL}",
                "CURRENT_DATESTAMP": "${DATESTAMP}"
            },
            "r2_buckets": [
                {
                    "binding": "BUCKET",
                    "bucket_name": "${EXTRACTS_BUCKET}"
                }
            ]
        },
        // Parameters for test code
        "test": {
            "name": "extracts-test",
            "vars": {
                "ORIGIN_BASE_URL": "${EXTRACTS_URL}",
                "CURRENT_DATESTAMP": "${DATESTAMP}"
            },
            "r2_buckets": [
                {
                    "binding": "BUCKET",
                    "bucket_name": "${EXTRACTS_BUCKET}"
                }
            ]
        }
    },
    "compatibility_date": "2025-10-12"
}
